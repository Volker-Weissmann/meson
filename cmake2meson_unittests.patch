+# limitations under the License.
+
+import unittest
+import os
+import inspect
+import sys
+# From https://stackoverflow.com/questions/714063/importing-modules-from-parent-folder
+currentdir = os.path.dirname(os.path.abspath(inspect.getfile(inspect.currentframe())))
+parentdir = os.path.dirname(currentdir)
+sys.path.insert(0, parentdir)
+import cmake2meson
+
+class TestConditions(unittest.TestCase):
+    def test_conditions(self):
+        condition_pairs = [
+            ('SOMEPACKAGE_FOUND', 'SOMEPACKAGE_dep.found()'),
+            ('APPLE', '(build_machine.system() == \'darwin\')'),
+            ('NOT BISON_FOUND', 'not ( BISON_dep.found() )'),
+            ('NOT a STREQUAL b', 'not ( a == b )'),
+            ('a OR b AND c', '( a or b ) and c')
+        ]
+        converter = cmake2meson.Converter('N/A')
+        lexer = cmake2meson.Lexer()
+        for (cmake_cond, meson_cond) in condition_pairs:
+            tokens = list(lexer.lex(cmake_cond, 'N/A'))
+            res = converter.convert_condition(tokens)
+            self.assertEqual(res, meson_cond)
+
+if __name__ == '__main__':
+    unittest.main()
