@@ -0,0 +1,19 @@
+project('cmake_code_gen', ['c', 'cpp'])
+
+cm = import('cmake')
+
+# Subproject with the "code generator"
+sub_pro = cm.subproject('cmMod')
+sub_final = sub_pro.dependency('final', include_type: 'system')
+var = sub_pro.target('cm_exe_local')
+
+gen = generator(var,
+                output  : '@BASENAME@.cpp',
+                arguments : ['@INPUT@', '@OUTPUT@'])
+
+gen_src = gen.process('input1.idl')
+
+# Build the exe
+exe = executable('main', ['main.cpp', gen_src], dependencies: [sub_final])
+
+test('test', exe)
